{
  "name": "mp-triple-noise",
  "observe": ["f", "r"],
  "initial_memory": { "x": 0, "flag": 0, "a": 0, "b": 0, "c": 0 },
  "threads": [
    [
      {"op": "store", "loc": "a", "value": 1, "atomic": true, "order": "relaxed"},
      {"op": "store", "loc": "b", "value": 1, "atomic": true, "order": "relaxed"},
      {"op": "store", "loc": "c", "value": 1, "atomic": true, "order": "relaxed"},
      {"op": "store", "loc": "x", "value": 1, "atomic": true, "order": "relaxed"},
      {"op": "fence", "order": "seq_cst"},
      {"op": "store", "loc": "flag", "value": 1, "atomic": true, "order": "relaxed"}
    ],
    [
      {"op": "load", "loc": "a", "target": "ta", "atomic": true, "order": "relaxed"},
      {"op": "load", "loc": "b", "target": "tb", "atomic": true, "order": "relaxed"},
      {"op": "load", "loc": "c", "target": "tc", "atomic": true, "order": "relaxed"},
      {"op": "load", "loc": "flag", "target": "f", "atomic": true, "order": "relaxed"},
      {"op": "fence", "order": "seq_cst"},
      {"op": "load", "loc": "x", "target": "r", "atomic": true, "order": "relaxed"},
      {"op": "assert_eq", "left": "r", "right": 1, "when": {"f": 1}}
    ]
  ]
}
