{
  "name": "coherence-rr",
  "description": "CoRR：T0 对 x 先写 1 再写 2（同址两写已有 po⊆hb，CoWW 固定 1 mo 2）。T1 与 T0 无 hb，旧 hb-极大写规则放行先读 2 再读旧值；存在性 mo 因 CoRR 成环而丢掉。两路完全并发写的 2-then-1 在存在性 mo 下其实合法，测不出缺口，所以这里用已有 hb 的两写。",
  "initial_memory": {
    "x": 0
  },
  "threads": [
    [
      {"op": "store", "loc": "x", "value": 1, "atomic": true, "order": "relaxed"},
      {"op": "store", "loc": "x", "value": 2, "atomic": true, "order": "relaxed"}
    ],
    [
      {"op": "load", "loc": "x", "target": "r1", "atomic": true, "order": "relaxed"},
      {"op": "load", "loc": "x", "target": "r2", "atomic": true, "order": "relaxed"},
      {"op": "assert_eq", "left": "r2", "right": 2, "when": {"r1": 2}}
    ]
  ]
}
