{
  "name": "sb-seq-cst",
  "observe": ["a", "b"],
  "initial_memory": { "x": 0, "y": 0 },
  "threads": [
    [
      {"op": "store", "loc": "x", "value": 1, "atomic": true, "order": "seq_cst"},
      {"op": "load", "loc": "y", "target": "a", "atomic": true, "order": "seq_cst"}
    ],
    [
      {"op": "store", "loc": "y", "value": 1, "atomic": true, "order": "seq_cst"},
      {"op": "load", "loc": "x", "target": "b", "atomic": true, "order": "seq_cst"}
    ]
  ]
}
